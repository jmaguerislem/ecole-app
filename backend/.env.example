# --- Base de données ---
DATABASE_URL=postgres://ecole:ecole@localhost:5432/ecole
DATABASE_SSL=false            # true sur Railway/Render/Neon si requis

# --- Sécurité (OBLIGATOIRE en production : chaîne aléatoire de 32+ caractères) ---
JWT_SECRET=change-me-please-with-a-long-random-string
JWT_EXPIRES=8h
CORS_ORIGIN=http://localhost:5173   # URL publique du frontend (laisser vide si servi par le backend). Les origines de l'app mobile (https://localhost, capacitor://localhost) sont ajoutées automatiquement.

# --- École ---
ECOLE_NOM=École Primaire Abou Kacem Chebbi
ANNEE_SCOLAIRE=                    # ex. 2026-2027 (par défaut : calculée automatiquement)
APP_URL=http://localhost:5173      # utilisée dans les e-mails

# --- Plateforme multi-écoles ---
PLATEFORME_NOM=Gestion scolaire    # nom affiché avant la connexion
SUPERADMIN_EMAIL=owner@exemple.tn  # compte du propriétaire de la plateforme (gère les écoles) ; créé au démarrage s'il n'existe pas
SUPERADMIN_PASSWORD=ChangeMoi!2026Super

# --- Première école : nom, puis son premier administrateur (créé s'il n'existe aucun admin) ---
ADMIN_EMAIL=admin@ecole.tn
ADMIN_PASSWORD=ChangeMoi!2026
ADMIN_NOM=Direction
ADMIN_PRENOM=École

# --- Stockage des fichiers (photos, devoirs, pièces jointes) ---
UPLOAD_DIR=./uploads               # monter un volume persistant en production (ou adapter services/storage pour S3)

# --- E-mail (SendGrid via SMTP, ou tout autre SMTP) – optionnel ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=                         # SendGrid : apikey
SMTP_PASS=
MAIL_FROM=ecole@example.com

# --- Notifications push (Web Push / VAPID) – optionnel ---
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ecole@example.com

# --- Divers ---
PORT=4000
AUTO_MIGRATE=true                  # applique schema.sql au démarrage
RELANCES_CRON=false                # true = relances d'impayés automatiques chaque lundi 8h

# Notifications push de l'application mobile (Firebase > Paramètres du projet > Comptes de service > Générer une clé).
# Coller le contenu du fichier JSON sur UNE seule ligne. Laisser vide pour désactiver.
FIREBASE_SERVICE_ACCOUNT=

# --- E-mails d'invitation des parents (création automatique du compte à l'ajout d'un élève) ---
# SMTP_HOST/SMTP_USER/SMTP_PASS/MAIL_FROM ci-dessus sont OBLIGATOIRES pour envoyer l'e-mail ; sans eux le compte parent est quand même créé,
# l'échec est signalé à l'administrateur et l'invitation peut être renvoyée depuis la fiche de l'élève.
# APP_URL apparaît dans l'e-mail (lien web de l'application).
# MAIL_TRANSPORT=memory   # tests uniquement : garde les e-mails en mémoire au lieu de les envoyer

# --- Comptes de démonstration de la page de connexion (connexion SANS mot de passe) ---
# Activés par défaut hors production ; en production, DEMO_LOGIN=true uniquement le temps d'une présentation (puis retirer).
# Préparer les données : npm run seed:demo   (3 écoles × administrateur, comptable, enseignant, élève, parent + loyers de démonstration)
DEMO_LOGIN=
